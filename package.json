{
  "name": "kiro-mcp-switcher",
  "displayName": "Kiro MCP Switcher",
  "description": "Switch Kiro MCP config presets (full mcpServers swap) and inspect the active mcp.json, without hand-editing JSON.",
  "version": "0.2.2",
  "publisher": "ytkoka",
  "author": {
    "name": "ytkoka"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ytkoka/kiro-mcp-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/ytkoka/kiro-mcp-switcher/issues"
  },
  "homepage": "https://github.com/ytkoka/kiro-mcp-switcher#readme",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kiro",
    "mcp",
    "model context protocol",
    "preset",
    "switcher"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiroMcpSwitcher",
          "title": "MCP Switcher",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kiroMcpSwitcher": [
        {
          "id": "kiroMcpSwitcher.view",
          "name": "MCP Switcher",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "kiroMcpSwitcher.refresh",
        "title": "Refresh",
        "category": "Kiro MCP",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroMcpSwitcher.selectTarget",
        "title": "Select Target (Workspace / User)",
        "category": "Kiro MCP",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kiroMcpSwitcher.openConfig",
        "title": "Open mcp.json",
        "category": "Kiro MCP",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kiroMcpSwitcher.toggleMask",
        "title": "Toggle Sensitive Values (show/hide)",
        "category": "Kiro MCP",
        "icon": "$(eye)"
      },
      {
        "command": "kiroMcpSwitcher.applyPreset",
        "title": "Apply Config Preset",
        "category": "Kiro MCP",
        "icon": "$(play)"
      },
      {
        "command": "kiroMcpSwitcher.savePresetFromCurrent",
        "title": "Save Current as Preset",
        "category": "Kiro MCP",
        "icon": "$(save)"
      },
      {
        "command": "kiroMcpSwitcher.newEmptyPreset",
        "title": "New Empty Preset",
        "category": "Kiro MCP",
        "icon": "$(new-file)"
      },
      {
        "command": "kiroMcpSwitcher.duplicatePreset",
        "title": "Duplicate Preset",
        "category": "Kiro MCP",
        "icon": "$(copy)"
      },
      {
        "command": "kiroMcpSwitcher.deletePreset",
        "title": "Delete Preset",
        "category": "Kiro MCP",
        "icon": "$(trash)"
      },
      {
        "command": "kiroMcpSwitcher.openPreset",
        "title": "Open Preset File",
        "category": "Kiro MCP",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kiroMcpSwitcher.restoreSnapshot",
        "title": "Restore Last Snapshot",
        "category": "Kiro MCP",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kiroMcpSwitcher.savePresetFromCurrent",
          "when": "view == kiroMcpSwitcher.view",
          "group": "navigation@0"
        },
        {
          "command": "kiroMcpSwitcher.toggleMask",
          "when": "view == kiroMcpSwitcher.view",
          "group": "navigation@1"
        },
        {
          "command": "kiroMcpSwitcher.selectTarget",
          "when": "view == kiroMcpSwitcher.view",
          "group": "navigation@2"
        },
        {
          "command": "kiroMcpSwitcher.refresh",
          "when": "view == kiroMcpSwitcher.view",
          "group": "navigation@3"
        },
        {
          "command": "kiroMcpSwitcher.openConfig",
          "when": "view == kiroMcpSwitcher.view",
          "group": "overflow@1"
        },
        {
          "command": "kiroMcpSwitcher.newEmptyPreset",
          "when": "view == kiroMcpSwitcher.view",
          "group": "overflow@2"
        },
        {
          "command": "kiroMcpSwitcher.restoreSnapshot",
          "when": "view == kiroMcpSwitcher.view",
          "group": "overflow@3"
        }
      ],
      "view/item/context": [
        {
          "command": "kiroMcpSwitcher.applyPreset",
          "when": "view == kiroMcpSwitcher.view && viewItem == preset",
          "group": "inline"
        },
        {
          "command": "kiroMcpSwitcher.openPreset",
          "when": "view == kiroMcpSwitcher.view && viewItem == preset",
          "group": "1_modify@1"
        },
        {
          "command": "kiroMcpSwitcher.duplicatePreset",
          "when": "view == kiroMcpSwitcher.view && viewItem == preset",
          "group": "1_modify@2"
        },
        {
          "command": "kiroMcpSwitcher.deletePreset",
          "when": "view == kiroMcpSwitcher.view && viewItem == preset",
          "group": "1_modify@3"
        }
      ]
    },
    "configuration": {
      "title": "Kiro MCP Switcher",
      "properties": {
        "kiroMcpSwitcher.target": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "enumDescriptions": [
            "Act on the workspace file: .kiro/settings/mcp.json",
            "Act on the user file: ~/.kiro/settings/mcp.json"
          ],
          "default": "workspace",
          "description": "Which mcp.json the switcher reads from and writes to."
        },
        "kiroMcpSwitcher.reloadWindowOnApplyPreset": {
          "type": "boolean",
          "default": false,
          "description": "After applying a config preset, automatically reload the window so Kiro re-reads mcp.json. Useful for a fast test loop; leave off to be prompted instead."
        },
        "kiroMcpSwitcher.maskSensitiveValues": {
          "type": "boolean",
          "default": true,
          "description": "In the Active Config view, hide likely-secret values (Authorization, token, key, secret, password, etc.). Toggle with the eye icon in the view title."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "smoke": "node scripts/smoke-activate.js",
    "test": "node --import tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.23.1",
    "ovsx": "^0.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
